{
    "name": "oliweb/statamic-privacy-analytics",
    "description": "Self-hosted, privacy-first analytics for Statamic. No third-party data transfer by default — MaxMind geolocation, configurable retention, granular CP permissions.",
    "type": "statamic-addon",
    "license": "MIT",
    "keywords": [
        "statamic",
        "statamic-addon",
        "analytics",
        "statamic-analytics",
        "enhanced",
        "real-time",
        "tracking",
        "cache",
        "performance",
        "dashboard",
        "chart",
        "chartjs",
        "alpinejs"
    ],
    "authors": [
        {
            "name": "OliWeb - Olivier Petrucciani",
            "email": "info@oliweb.ch",
            "homepage": "https://oliweb.ch"
        }
    ],
    "funding": [
        {
            "type": "other",
            "url": "https://donate.stripe.com/aFaaEW3Wq7TH2wLa5pf3a00"
        }
    ],
    "support": {
        "email": "info@oliweb.ch",
        "github": "https://github.com/oliweb-ch/statamic-privacy-analytics"
    },
    "autoload": {
        "psr-4": {
            "Oliweb\\StatamicAnalytics\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oliweb\\StatamicAnalytics\\Tests\\": "tests"
        }
    },
    "extra": {
        "statamic": {
            "name": "Privacy Analytics",
            "description": "Self-hosted, privacy-first analytics for Statamic. No third-party data transfer by default — MaxMind geolocation, configurable retention, granular CP permissions."
        },
        "laravel": {
            "providers": [
                "Oliweb\\StatamicAnalytics\\ServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0",
        "geoip2/geoip2": "^3.0",
        "matomo/device-detector": "^6.5"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    }
}
